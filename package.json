{
  "name": "fraudstream",
  "version": "0.0.0",
  "private": true,
  "description": "Real-time payment fraud detection platform (Kafka, NestJS, PostgreSQL, React)",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint && eslint *.js *.ts",
    "typecheck": "nx run-many -t typecheck && tsc -p tsconfig.json",
    "test": "nx run-many -t test",
    "test:coverage": "nx run-many -t test -- --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "topics:generate": "pnpm --filter @fraudstream/contracts topics:generate",
    "topics:verify": "bash scripts/verify-topics.sh",
    "prepare": "husky",
    "db:migrate": "tsx --tsconfig tsconfig.runtime.json --conditions=@fraudstream/source scripts/db-migrate.ts",
    "test:integration": "nx run-many -t test:integration",
    "env:init": "tsx --tsconfig tsconfig.runtime.json scripts/env-init.ts",
    "vault:rotate": "pnpm --filter @fraudstream/card-vault rotate",
    "apikey:create": "pnpm --filter @fraudstream/transaction-api apikey:create",
    "test:security": "pnpm --filter @fraudstream/security-tests test:security",
    "migrations:add-inbox": "tsx --tsconfig tsconfig.runtime.json scripts/add-inbox-migration.ts",
    "dlq:replay": "tsx --tsconfig tsconfig.runtime.json --conditions=@fraudstream/source scripts/dlq-replay.ts",
    "test:e2e": "pnpm --filter @fraudstream/e2e-tests test:e2e",
    "test:contracts": "pnpm --filter @fraudstream/contract-tests test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@fraudstream/db": "workspace:*",
    "@fraudstream/kafka": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "nx": "23.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
