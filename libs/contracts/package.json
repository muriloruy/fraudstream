{
  "name": "@fraudstream/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Event envelope, v1 event payloads, topic catalogue and header names (SPEC \u00a74)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@fraudstream/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "topics:generate": "tsx --conditions=@fraudstream/source scripts/generate-topics-conf.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
