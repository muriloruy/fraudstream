{
  "name": "@fraudstream/http",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS HTTP building blocks: RFC 9457 problem details, Zod validation pipe, health checks",
  "type": "module",
  "exports": {
    ".": {
      "@fraudstream/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fraudstream/observability": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/testing": "12.1.3",
    "@types/express": "5.0.6"
  }
}
