{
  "name": "@fraudstream/service-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Bootstrap for Kafka consumer services: pool, producer, consumers, embedded outbox relay, jobs, health and metrics",
  "type": "module",
  "exports": {
    ".": {
      "@fraudstream/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fraudstream/db": "workspace:*",
    "@fraudstream/http": "workspace:*",
    "@fraudstream/kafka": "workspace:*",
    "@fraudstream/observability": "workspace:*",
    "@fraudstream/outbox": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "nestjs-pino": "5.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
