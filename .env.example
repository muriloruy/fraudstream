# Copy to .env (git-ignored) and replace every placeholder. Never commit real secrets.
# Services refuse to boot with placeholder secrets when NODE_ENV=production (SPEC §14.3).
NODE_ENV=development

# PostgreSQL superuser, used only by the container's first-start scripts.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# One login role per service, each limited to its own schema (SPEC §5).
# The Postgres container creates the roles with the passwords in these URLs.
DATABASE_URL_PAYMENTS=postgres://payments_svc:change-me@localhost:5432/fraudstream
DATABASE_URL_VAULT=postgres://vault_svc:change-me@localhost:5432/fraudstream
DATABASE_URL_FRAUD_RULES=postgres://fraud_rules_svc:change-me@localhost:5432/fraudstream
DATABASE_URL_ANOMALY=postgres://anomaly_svc:change-me@localhost:5432/fraudstream
DATABASE_URL_DECISION=postgres://decision_svc:change-me@localhost:5432/fraudstream
DATABASE_URL_LEDGER=postgres://ledger_svc:change-me@localhost:5432/fraudstream
DATABASE_URL_ALERTS=postgres://alerts_svc:change-me@localhost:5432/fraudstream
# Read-only role for `pnpm ledger:reconcile` (SELECT on ledger and decision only).
DATABASE_URL_RECONCILER=postgres://reconciler:change-me@localhost:5432/fraudstream

# Kafka (host ports of the 3 brokers; the lowmem profile only has the first one).
KAFKA_BROKERS=localhost:19092,localhost:29092,localhost:39092
KAFKA_CLIENT_ID_PREFIX=fraudstream

# card-vault keys (SPEC §6.2). Generate with: openssl rand -base64 32
# `pnpm env:init` creates .env with random values for every placeholder below.
# Add VAULT_DEK_V2 (and so on) to rotate keys; the highest version encrypts new cards.
VAULT_DEK_V1=base64:REPLACE_WITH_32_RANDOM_BYTES
VAULT_HMAC_KEY=base64:REPLACE_WITH_32_RANDOM_BYTES
VAULT_SERVICE_TOKEN=change-me
VAULT_ADMIN_TOKEN=change-me
VAULT_URL=http://localhost:3001

# alerts-gateway auth (SPEC §6.8). JWT_ACCESS_SECRET needs at least 32 characters.
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Dashboard origins allowed to call the gateway with cookies (comma-separated, never "*").
CORS_ORIGINS=http://localhost:5173
# Demo users created by `pnpm users:seed` (analyst@demo.local, admin@demo.local).
DEMO_ANALYST_PASSWORD=change-me
DEMO_ADMIN_PASSWORD=change-me

# Pepper for hashing IPs and device ids (SPEC §4.9)
HASH_PEPPER=change-me

# decision-engine and anomaly-scorer tuning (SPEC §6.5, §6.6)
DECISION_APPROVE_BELOW=0.40
DECISION_DECLINE_FROM=0.75
DECISION_JOIN_TIMEOUT_MS=2000
ANOMALY_ALPHA=0.1

# OpenTelemetry (SPEC §10). Inside compose the services use http://jaeger:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Grafana admin (observability profile, http://localhost:3100). Dashboards are readable anonymously.
GRAFANA_ADMIN_PASSWORD=change-me

# Simulator (SPEC §6.9). Without SIM_API_KEY, pnpm sim:run registers its own key.
SIM_API_URL=http://localhost:3000
# SIM_API_KEY=
