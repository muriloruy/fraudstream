{
  "name": "@fraudstream/outbox-relay",
  "version": "0.0.0",
  "private": true,
  "description": "Publishes a service's transactional outbox to Kafka (SPEC §4.5, §6.3)",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx --conditions=@fraudstream/source src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fraudstream/db": "workspace:*",
    "@fraudstream/kafka": "workspace:*",
    "@fraudstream/observability": "workspace:*",
    "@fraudstream/outbox": "workspace:*",
    "zod": "4.6.7"
  }
}
