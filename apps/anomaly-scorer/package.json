{
  "name": "@fraudstream/anomaly-scorer",
  "version": "0.0.0",
  "private": true,
  "description": "Per-account EWMA anomaly scoring with cold start and analyst feedback (SPEC §6.5)",
  "type": "module",
  "exports": {
    "./contract": {
      "@fraudstream/source": "./src/contract.ts",
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import @fraudstream/observability/register dist/main.js",
    "dev": "nx run @fraudstream/anomaly-scorer:build && node --env-file-if-exists=../../.env --import @fraudstream/observability/register dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@fraudstream/contracts": "workspace:*",
    "@fraudstream/db": "workspace:*",
    "@fraudstream/kafka": "workspace:*",
    "@fraudstream/observability": "workspace:*",
    "@fraudstream/outbox": "workspace:*",
    "@fraudstream/service-kit": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fraudstream/testing": "workspace:*"
  }
}
