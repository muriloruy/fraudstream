{
  "name": "@fraudstream/alerts-gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Analyst API: auth, alert queue, audit log, SSE stream, admin operations (SPEC §6.8)",
  "type": "module",
  "exports": {
    "./contract": {
      "@fraudstream/source": "./src/contract.ts",
      "types": "./dist/contract.d.ts",
      "default": "./dist/contract.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nx run @fraudstream/alerts-gateway:build && node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.int.config.ts",
    "seed": "tsx --tsconfig ../../tsconfig.runtime.json --conditions=@fraudstream/source src/seed-users.ts"
  },
  "dependencies": {
    "@fraudstream/contracts": "workspace:*",
    "@fraudstream/db": "workspace:*",
    "@fraudstream/http": "workspace:*",
    "@fraudstream/kafka": "workspace:*",
    "@fraudstream/observability": "workspace:*",
    "@fraudstream/outbox": "workspace:*",
    "@fraudstream/security": "workspace:*",
    "@fraudstream/service-kit": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fraudstream/testing": "workspace:*",
    "@types/cookie-parser": "1.4.10"
  }
}
