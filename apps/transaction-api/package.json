{
  "name": "@fraudstream/transaction-api",
  "version": "0.0.0",
  "private": true,
  "description": "Public authorization API: validation, idempotency, vault tokenization, outbox (SPEC \u00a76.1)",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx --conditions=@fraudstream/source src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.int.config.ts",
    "apikey:create": "tsx --conditions=@fraudstream/source src/create-api-key.ts"
  },
  "dependencies": {
    "@fraudstream/contracts": "workspace:*",
    "@fraudstream/db": "workspace:*",
    "@fraudstream/http": "workspace:*",
    "@fraudstream/kafka": "workspace:*",
    "@fraudstream/observability": "workspace:*",
    "@fraudstream/outbox": "workspace:*",
    "@fraudstream/security": "workspace:*",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/throttler": "6.7.1",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fraudstream/testing": "workspace:*"
  }
}
