    {
      "id": 17,
      "type": "timeseries",
      "title": "Lag by partition (fraud flow)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
