# Production server of the analyst dashboard (SPEC §8, M6 task 4.1).
# Serves the static build and reverse-proxies the gateway on the same origin, so the
# refresh and stream cookies stay same-site and no CORS is needed.
{
	admin off
	auto_https off
}

:8081 {
	encode zstd gzip

	header {
		# No inline scripts, no eval, no third-party origins (SPEC §7). Inline *styles* are
		# allowed: React style attributes and the chart library set them.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# The live stream must not be buffered (ADR-006).
	handle /v1/stream* {
		reverse_proxy {$GATEWAY_UPSTREAM:alerts-gateway:3006} {
			flush_interval -1
		}
	}
	handle /auth/* {
		reverse_proxy {$GATEWAY_UPSTREAM:alerts-gateway:3006}
	}
	handle /v1/* {
		reverse_proxy {$GATEWAY_UPSTREAM:alerts-gateway:3006}
	}
	handle /admin/* {
		reverse_proxy {$GATEWAY_UPSTREAM:alerts-gateway:3006}
	}

	handle {
		root * /srv
		# Hashed assets never change; the HTML always revalidates.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
